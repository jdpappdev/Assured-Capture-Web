rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /test/connection {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;

      match /issues/{issueId} {
        allow read, write: if true;

        match /photos/{photoId} {
          allow read, write: if true;
        }
      }
    }
  }
}
